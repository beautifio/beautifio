# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (VPS Postfix relay, port 25, no auth)
SMTP_HOST=172.16.1.1
SMTP_PORT=25
MAIL_FROM_NAME=Beautifio
# Desired branded sender. Auto-activated only once SPF + DKIM DNS records for
# this domain are published (see docs/mail-dns-beautifio.md).
MAIL_FROM_ADDRESS=noreply@beautifio.com
# SPF-aligned safe fallback while DNS is not ready.
MAIL_FROM_FALLBACK=noreply@tukangjajan.com
MAIL_VPS_IP=31.97.49.146
# MAIL_FROM_FORCE=1   # optionally bypass the DNS readiness gate
# MAIL_NOREPLY_USER=  # optional SMTP auth for port 587
# MAIL_NOREPLY_PASS=
